# Public HTTPS origin used for canonical URLs, sitemap, and metadata.
NEXT_PUBLIC_SITE_URL=https://unimem.org
# Contact delivery: server-only. Create a verified sender in Resend.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Upstash Redis REST API; required for durable, atomic contact rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate with: openssl rand -hex 32. HMAC-hashes IPs before Redis storage.
CONTACT_RATE_LIMIT_SECRET=
# Analytics is opt-in. Set true after reviewing the privacy notice.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
